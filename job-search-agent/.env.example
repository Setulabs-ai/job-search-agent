# Copy to .env (or export these directly) before running any phase.

# Required by the Claude Agent SDK / Claude Code CLI it wraps.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides -- sensible defaults are used if you leave these unset.
# JOB_SEARCH_AGENT_MODEL=claude-opus-4-5
# JOB_SEARCH_AGENT_STATE_DIR=./state
# JOB_SEARCH_AGENT_MAX_TURNS=40
